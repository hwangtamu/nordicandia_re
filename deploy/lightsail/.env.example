NORD_IMAGE=nordicandia-server:REPLACE_WITH_COMMIT_SHA
NORD_CERT_PWD=REPLACE_WITH_CERTIFICATE_PASSWORD
NORD_HOME=/opt/nordicandia
# Keep loopback until the Lightsail firewall is restricted to approved player IPs.
NORD_BIND_IP=127.0.0.1
NORD_PUBLIC_PORT=443

# Authentication. 0 = only verified provider tokens or email/username credentials are accepted.
# Set to 1 only for local development (legacy trust-the-device behaviour).
NORD_AUTH_ALLOW_UNVERIFIED_PROVIDERS=0
NORD_ALLOW_REGISTRATION=1
# Optional provider verification. Leave blank to reject that provider in strict mode.
NORD_STEAM_WEBAPI_KEY=
NORD_GOOGLE_CLIENT_ID=
NORD_GOOGLE_CLIENT_SECRET=
